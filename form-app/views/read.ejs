<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Users</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
    
    <h1 class="text-2xl font-bold mb-10">Users</h1>

    <div class="flex flex-wrap gap-6">
      <% allUser.forEach((user) => { %>
        <div class="max-w-72 bg-zinc-700 rounded-lg p-5">
          
          <div class="w-full h-72 overflow-hidden rounded">
            <img 
              src="https://plus.unsplash.com/premium_photo-1769380789163-cf2f0a79b20a?w=800&auto=format&fit=crop&q=60"
              class="w-full h-full object-cover"
              alt="User image"
            />
          </div>

          <div class="font-bold text-lg mt-4">
            <%= user.name %>
          </div>

          <div class="text-sm text-zinc-300 mt-1">
            <%= user.email %>
          </div>

        </div>
      <% }) %>
    </div>

  </div>
</body>
</html>
