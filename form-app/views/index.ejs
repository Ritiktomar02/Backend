<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
     <h1 class="text-xl font-bold mb-10">Add New User</h1>
     <form action="/create" method="post">
        <input class="bg-zinc-700 outline-none px-5 py-2 rounded border-2 border-transparent" placeholder="Write your name" name="name" type="text"/>
        <input class="bg-zinc-700 outline-none px-5 py-2 rounded border-2 border-transparent" placeholder="Write your email" name="email" type="text"/>
        <input class="bg-zinc-700 outline-none px-5 py-2 rounded border-2 border-transparent" placeholder="Write your image address" name="image" type="text"/>
        <button type="submit" class="px-8 py-2 bg-blue-600 rounded border-2 border-transparent"> Create</button>
     </form>
    </div>
</body>
</html>