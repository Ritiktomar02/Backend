<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>Upload file</title>
</head>
<body>
  <div class="min-h-screen w-full bg-zinc-900 text-white p-10">

    <form
      action="/upload"
      method="post"
      enctype="multipart/form-data"
      class="mb-6"
    >
      <input type="file" name="file" class="bg-zinc-700 p-2" />
      <button
        type="submit"
        class="px-5 py-2 bg-blue-600 rounded ml-2"
      >
        Submit
      </button>
    </form>

    <div class="grid grid-cols-4 gap-4">
      <% allfiles.forEach(file => { %>
        <div class="w-48 h-48 border rounded overflow-hidden">
          <img
            src="/<%= file.imgUrl %>"
            class="w-full h-full object-cover"
          />
        </div>
      <% }) %>
    </div>

  </div>
</body>
</html>
