<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Social Media</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>

    <div class="min-h-screen w-full bg-zinc-900 text-white p-10">

          <a href="/sign-in" class="bg-blue-500 px-5 py-2 rounded mb-5">Login</a>

        <h1 class="mb-5 font-bold text-xl py-5">Register </h1>
        
        <form action="/register" method="post">
            <input class="outline-none border-2 border-transparent rounded py-2 px-3 bg-zinc-700 mx-2 " type="text" name="username" placeholder="username"/>
            <input class="outline-none border-2 border-transparent rounded py-2 px-3 bg-zinc-700 mx-2 " type="email" name="email" placeholder="email"/>
            <input class="outline-none border-2 border-transparent rounded py-2 px-3 bg-zinc-700 mx-2 " type="password" name="password" placeholder="password"/>
            <input class="px-5 py-2 bg-blue-500 rounded border-transparent" type="submit" value="submit"/>
        </form>
        
    </div>
  </body>
</html>
